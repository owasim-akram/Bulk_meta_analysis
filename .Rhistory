library(tidyverse)
library(DESeq2)
library(ggrepel)
library(ggrepel)
pak::pkg_install("ggrepel")
library(ggrepel)
# load raw count
raw_counts  <- readxl::read_excel("data/raw_counts/GSE262612_raw_counts.xlsx")
View(raw_counts)
# Load metadata
metadata <- read.csv("data/metadata/GSE262612_metadata.csv")
View(metadata)
glimpse(metadat)
glimpse(metadata)
View(raw_counts)
# 1. Move Geneid from a column into row names
counts <- as.data.frame(raw_counts)
rownames(counts) <- counts$Geneid
counts$Geneid <- NULL
# 2. Build a metadata table with one row per SRR column
metadata <- data.frame(sample = colnames(counts))
rownames(metadata) <- metadata$sample
# 3. Add the condition column (edit to match your real groups)
metadata$condition <- c("control", "control", "control", "heat", "heat", "heat")
metadata$condition <- factor(metadata$condition, levels = c("control", "heat"))
# 4. Check that they match
all(rownames(metadata) == colnames(counts))   # must be TRUE
